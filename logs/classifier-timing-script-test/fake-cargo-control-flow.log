# 2026-11-08T23:33:41Z classifier_timing_probe.sh control-flow test with a fake cargo (no Rust build); script sha256 b48d921b261fb0844aeae91654b3033c03de0c5f250671fb982eb6e2e341b8fd
## fake cargo
#!/bin/bash
case " $* " in *" --no-run "*) echo "fake build"; exit 0;; esac
[ "$PROBE_UNITS" = 3 ] && sleep 5
[ "$PROBE_PATTERN" = crash ] && exit 3
for r in warmup $(seq 1 "$PROBE_REPS"); do printf 'probe\t%s\t%s\t%s\t%s\t%s\tNone\n' "$PROBE_PATTERN" "$PROBE_UNITS" 10 "$r" $((PROBE_UNITS*1000000)); done
